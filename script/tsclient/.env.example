# RPC (optional if hardhat.config networks already have url)
RPC_URL=https://arb1.arbitrum.io/rpc

# Signer
PRIVATE_KEY=0x...

# Gateway & Vault (required for deposit / redeem)
GATEWAY_ADDRESS=0x...
VAULT_ADDRESS=0x...

# --- RolesAuthority (roles-authority-update.ts, roles-authority-check.ts) ---
# Địa chỉ contract RolesAuthority (trong log deploy: "Authority deployed at: 0x...")
# ROLES_AUTHORITY_ADDRESS=0x...
# Owner sẽ được gán ADMIN_ROLE; nếu không set OWNER_ADDRESS thì dùng signer
# OWNER_ADDRESS=0x...
# Check script: USER_ADDRESS=0x... (default signer), ROLE=1 (default)
# USER_ADDRESS=0x...
# ROLE=1

# --- Deposit ---
ASSETS=1000000
# RECEIVER=0x...       # default: signer
# MIN_SHARES_OUT=0
# PARTNER_ID=0

# --- Redeem ---
# SHARES=1000000
# MIN_ASSETS_OUT=0
# PARTNER_ID=0

# --- Quote (view): set ASSETS and/or SHARES ---
# --- Allowances (view): OWNER=0x... or default signer ---
# OWNER=0x...
